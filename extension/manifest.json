{
  "manifest_version": 3,
  "name": "PhraseNest - Reddit English Notes",
  "version": "0.1.1",
  "description": "Redditで選択した英文をその場で翻訳し、単語・熟語と一緒に保存します。",
  "minimum_chrome_version": "138",
  "permissions": ["storage", "identity", "activeTab"],
  "host_permissions": ["https://*.reddit.com/*", "https://*.supabase.co/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "選択した英文をPhraseNestで開く" },
  "options_page": "options.html",
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "選択した英文を翻訳する"
    }
  },
  "content_scripts": [{ "matches": ["https://*.reddit.com/*"], "js": ["content-script.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["panel.css"], "matches": ["https://*.reddit.com/*"] }]
}
