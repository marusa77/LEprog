{
  "manifest_version": 3,
  "name": "PhraseNest - English Notes",
  "version": "0.10.0",
  "description": "呼び出したページで選択した英文を翻訳し、単語・熟語と一緒に保存します。",
  "minimum_chrome_version": "138",
  "permissions": ["storage", "identity", "activeTab", "scripting"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "PhraseNestを開く", "default_popup": "launcher.html" },
  "options_page": "options.html",
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "選択した英文を翻訳する"
    }
  },
  "web_accessible_resources": [{ "resources": ["panel.css"], "matches": ["https://*/*", "http://*/*"] }]
}
